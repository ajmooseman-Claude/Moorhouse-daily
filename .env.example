# Copy to .env for local runs. Never commit the real values.
# On Vercel, add these under Project > Settings > Environment Variables.

DASHBOARD_PASSWORD=
SESSION_SECRET=
CRON_SECRET=
ANTHROPIC_API_KEY=

# Optional. Outlook / Microsoft 365 sign-in. See the README.
MS_CLIENT_ID=

# Optional. Upstash Redis. Vercel fills these in when you connect storage.
# Without them, data stays in memory and disappears when the process stops.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional. Lets The main man post the brief, the three things and alerts.
# A long random string. He sends it as: Authorization: Bearer <this value>
MAIN_MAN_API_KEY=

# Optional. The message box on the dashboard posts here.
# On Vercel the address must start with https://
MAIN_MAN_WEBHOOK_URL=
MAIN_MAN_WEBHOOK_KEY=

# Optional. Header name for MAIN_MAN_WEBHOOK_KEY.
# Leave unset to send Authorization: Bearer <key>.
# Set X-Api-Key (or the name the webhook expects) to send the key as that header's value.
MAIN_MAN_WEBHOOK_KEY_HEADER=
